<h2 class="a-title-2 h-mb-10">Tooltips</h2>
<div class="h-ml-150">
    <a href="#_" class="a-tip">
        {{ macros.btnSpan('','as--icon-only', 'close', '20') }}
        <span class="tip-text as--left">Tooltip à gauche</span>
    </a>

    <a href="#_" class="a-tip">
        {{ macros.btnSpan('','as--icon-only', 'close', '20') }}
        <span class="tip-text as--bottom">Tooltip en bas</span>
    </a>

    <a href="#_" class="a-tip">
        {{ macros.btnSpan('','as--icon-only', 'close', '20') }}
        <span class="tip-text as--top">Tooltip en haut</span>
    </a>

    <a href="#_" class="a-tip">
        {{ macros.btnSpan('','as--icon-only', 'close', '20') }}
        <span class="tip-text as--right">Tooltip à droite</span>
    </a>
</div>