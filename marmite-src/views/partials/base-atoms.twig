<h2 class="a-title-1">Niveau de titre 1 (a-title-1)</h2>
<h2 class="a-title-2">Niveau de titre 2 (a-title-2)</h2>
<h2 class="a-title-3">Niveau de titre 3 (a-title-3)</h2>
<h2 class="a-title-4">Niveau de titre 4 (a-title-4)</h2>

<br>
<br>

<p class="a-title-1 as--underline-hover">Texte de plusieurs lignes qui est soulignée progressivement lors du survol de la souris</p>

<br>
<br>
<br>

<h2 class="a-title-2 h-mb-10">Base icons</h2>
{% set aIcons = [
    "arrow-down",
    "arrow-left",
    "burger",
    "close",
    "search",
] %}
{% for iconName in aIcons %}
    {{ macros.svg(iconName,'25','as--secondary') }}
{% endfor %}

<br>
<br>
<br>


<h2 class="a-title-2 h-mb-10">Buttons</h2>
{{ macros.btnButton('Bouton classique','') }}
{{ macros.btnButton('Bouton alternatif','as--secondary') }}
{{ macros.btnButton('Bouton blanc','as--white') }}
{{ macros.btnButton('Bouton transparent','as--ghost') }}
{{ macros.btnButton('','as--icon-only', 'arrow-down', '25', 'Passer à la slide suivante') }}
{{ macros.btnButton('','as--icon-only as--secondary', 'arrow-down', '20', 'Passer à la slide suivante') }}
{{ macros.btnButton('','as--icon-only as--white', 'arrow-down', '15', 'Passer à la slide suivante') }}
{{ macros.btnButton('','as--icon-only as--ghost', 'arrow-down', '12', 'Passer à la slide suivante') }}
{{ macros.btnButton('Texte et icône','', 'arrow-down', '15') }}
{{ macros.btnButton('Texte et icône','as--icon-right', 'arrow-down', '15') }}
{{ macros.btnButton('Texte et icône','as--icon-top', 'arrow-down', '15') }}
{{ macros.btnButton('Texte et icône','as--icon-bottom', 'arrow-down', '15') }}
<button class="a-button" data-text-hover="Cas d'étude">Animation au survol</button>
{{ macros.btnButton('Bouton Désactivé','','','','',{'disabled': ''}) }}

<br>
<br>
<br>

