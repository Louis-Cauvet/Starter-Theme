{# Double columns #}
<section class="editor-wysiwyg">
    <ul class="editor-col">
        {% for i in 1..2 %}
            <li class="col">
                <div class="editor-img as--conserved-ratio">
                    <img src="https://picsum.photos/1000/45{{ i }}" alt="Texte alternatif" width="1000" height="450" loading="lazy">
                </div>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed orci mauris, sagittis in ex vel,
                    posuere euismod leo. Etiam sodales, libero sed porta pulvinar, velit sem vehicula nulla,
                    eget suscipit massa erat id justo. Suspendisse neque turpis, accumsan non tortor non,
                    commodo sagittis leo. Cras quis risus massa.
                </p>
                {{ macros.btnLink('Bouton classique','', '#_') }}
            </li>
        {% endfor %}
    </ul>
</section>

