{# Simple fullwidth images' slider with controls (using Swiper.js : https://swiperjs.com) #}
<section class="swiper-slider-simple swiper editor-wysiwyg">
    <ul class="swiper-wrapper">
        {% for i in 1..3 %}
            <li class="swiper-slide editor-img as--overlay">
                <img src="https://picsum.photos/1680/70{{ i }}" alt="Texte alternatif" width="1680" height="70{{ i }}">
            </li>
        {% endfor %}
    </ul>

    <button class="swiper-button-prev swiper-arrow">
        {{ macros.svg('arrow-left','40','as--white') }}
    </button>
    <button class="swiper-button-next swiper-arrow">
        {{ macros.svg('arrow-left','40','as--white') }}
    </button>

    <div class="swiper-pagination"></div>
</section>

{# Simple fullwidth images' slider with autoplay & infinite (using Swiper.js : https://swiperjs.com) #}
<section class="swiper-slider-simple-autoplay swiper editor-wysiwyg">
    <ul class="swiper-wrapper">
        {% for i in 1..3 %}
            <li class="swiper-slide editor-img as--overlay">
                <img src="https://picsum.photos/1680/70{{ i }}" alt="Texte alternatif" width="1680" height="70{{ i }}">
            </li>
        {% endfor %}
    </ul>
</section>

{# Five keynumbers' slider (using Swiper.js : https://swiperjs.com) #}
<section class="swiper-slider-five swiper editor-wysiwyg as--exceed-inner-wrap">
    <ul class="swiper-wrapper">
        <li class="swiper-slide">
            <div class="keynumber-card">
                <p>
                    <span class="keynumber-value">178082</span>
                    tasses de cafés englouties par l'équipe
                </p>
            </div>
        </li>
        <li class="swiper-slide">
            <div class="keynumber-card">
                <p>
                    <span class="keynumber-value">2570</span>
                    € de chiffre d'affaires mensuels
                </p>
            </div>
        </li>
        <li class="swiper-slide">
            <div class="keynumber-card">
                <p>
                    <span class="keynumber-value">100%</span>
                    de clients satisfaits
                </p>
            </div>
        </li>
        <li class="swiper-slide">
            <div class="keynumber-card">
                <p>
                    <span class="keynumber-value">24h</span>
                    de bonne humeur par jour
                </p>
            </div>
        </li>
        <li class="swiper-slide">
            <div class="keynumber-card">
                <p>
                    <span class="keynumber-value">7/7</span>
                    jours ouverts
                </p>
            </div>
        </li>
    </ul>

    <button class="swiper-button-prev swiper-arrow">
        {{ macros.svg('arrow-left','40','as--dark-primary') }}
    </button>
    <button class="swiper-button-next swiper-arrow">
        {{ macros.svg('arrow-left','40','as--dark-primary') }}
    </button>
</section>